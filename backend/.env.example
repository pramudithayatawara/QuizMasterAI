# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/quizmaster

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# AES Encryption
AES_SECRET_KEY=your_aes_secret_key_here_min_32_chars
AES_IV_LENGTH=16

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=QuizMaster AI <noreply@quizmaster.ai>

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini Configuration (Alternative AI Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# AI Provider Selection (openai or gemini)
AI_PROVIDER=openai

# Vector Store Configuration
VECTOR_STORE_PATH=./vectorstore
VECTOR_DIMENSION=1536

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Account Security
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=900000

# Password Reset
PASSWORD_RESET_EXPIRES=3600000