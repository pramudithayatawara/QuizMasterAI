# ─── PDF Processing Environment Variables ───────────────────────────────────────

# Local HuggingFace Embeddings (via @xenova/transformers)
# Uses local model 'Xenova/all-MiniLM-L6-v2' - No API key required
# Works completely offline and free
# The model will be downloaded automatically on first use

# PDF Processing Configuration
PDF_MAX_FILE_SIZE=10485760  # 10MB in bytes
PDF_CHUNK_SIZE=1000
PDF_CHUNK_OVERLAP=200

# MongoDB Configuration (for vector search)
MONGODB_URI=mongodb+srv://your_mongodb_uri
DATABASE_NAME=quizmaster_ai

# Existing Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
